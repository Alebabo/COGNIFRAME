# ==============================================================================
# Palantum AI - Environment Configuration
# ==============================================================================
# Trage hier deine API-Schlüssel ein. Die Datei kann als '.env' im Hauptverzeichnis
# gespeichert werden und wird von Palantum automatisch geladen.
# ==============================================================================

# 1. Devin API Key (v3-Service-Key: cog_; Legacy-v1: apk_ / apk_user_)
# Registrierung / API-Keys: https://app.devin.ai/settings/api-keys
# Ein Legacy-Key kann zusätzlich zu DEVIN_PAT als sicherer v1-Fallback gesetzt werden.
DEVIN_API_KEY=

# Devin-v3-PAT. Dieser Schlüssel wird ausschließlich an v3 gesendet.
DEVIN_PAT=

# Optionale Organisations-ID für Devin v3 (wird sonst über /v3/self ermittelt)
DEVIN_ORG_ID=

# Optionale Devin API URL (Standard: https://api.devin.ai/v1)
DEVIN_API_URL=https://api.devin.ai/v1

# Erforderliche lokale/extern bereitgestellte Motion-Pack-Quelle für Variante B.
# Das Pack selbst bleibt wegen ungeklärter Redistributionsrechte außerhalb des Repositories.
PALANTUM_TEMPLATE_SOURCE=

# 2. OpenAI API Key (ausschließlich für Whisper-Transkription)
# API-Keys: https://platform.openai.com/api-keys
OPENAI_API_KEY=
