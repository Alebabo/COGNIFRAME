# ==============================================================================
# Pitchcraft AI - Environment Configuration
# ==============================================================================
# Enter your API keys here. The file can be stored as '.env' in the project root
# Pitchcraft only fills variables that are not already set in the
# process environment.
#
# When credentials are injected externally, start via scripts/serve.ps1 or
# scripts/serve.sh. These launchers use `uv run --no-env-file` so uv does not load a
# local .env before the program starts.
# ==============================================================================

# 1. Devin API Key (v3-Service-Key: cog_; Legacy-v1: apk_ / apk_user_)
# Registration / API keys: https://app.devin.ai/settings/api-keys
# A legacy key can additionally be set as a secure v1 fallback alongside DEVIN_PAT.
DEVIN_API_KEY=

# Devin v3 PAT. This key is sent exclusively to v3.
DEVIN_PAT=

# Optional organization ID for Devin v3 (otherwise discovered via /v3/self)
DEVIN_ORG_ID=

# Optional Devin API URL (default: https://api.devin.ai/v1)
DEVIN_API_URL=https://api.devin.ai/v1

# Required local or externally provided Motion Pack source for Variant B.
# The pack itself remains outside the repository because redistribution rights are unresolved.
PITCHCRAFT_TEMPLATE_SOURCE=

# 2. OpenAI API key (used exclusively for Whisper transcription)
# API keys: https://platform.openai.com/api-keys
OPENAI_API_KEY=
